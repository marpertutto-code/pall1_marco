# Supabase - pubbliche, sicure nel bundle (protette da RLS)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# URL pubblico dell'app (usato per redirect auth/email e per i link nelle notifiche)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Notifiche Telegram ---
# Token del bot (BotFather) e username senza @. Il secret è una stringa casuale
# che Telegram rimanda nell'header di ogni aggiornamento: serve a scartare le
# chiamate false al webhook.
TELEGRAM_BOT_TOKEN=123456:ABC...
TELEGRAM_BOT_USERNAME=IlTuoBot
TELEGRAM_WEBHOOK_SECRET=cambia-questa-stringa-casuale

# Opzionale: se impostato, l'endpoint dei promemoria partita richiede
# "Authorization: Bearer <segreto>". Va messo anche nell'header del job pg_net.
CRON_SECRET=

# Solo locale / CI / script - NON prefissare con NEXT_PUBLIC_
# La service role serve al webhook di Telegram e all'invio delle notifiche.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
SUPABASE_PROJECT_ID=il-tuo-project-ref
