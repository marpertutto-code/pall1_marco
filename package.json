{
  "name": "pall1",
  "version": "1.0.0",
  "private": true,
  "description": "Pall1 - gestionale partite di calcetto tra amici",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "check:contrast": "node scripts/check-contrast.mjs",
    "build:icons": "node scripts/build-icons.mjs",
    "build:og": "node scripts/build-og-image.mjs",
    "build:brand": "npm run build:icons && npm run build:og",
    "build:bot-avatar": "node scripts/build-bot-avatar.mjs",
    "logo:trace": "python scripts/trace-logo.py",
    "logo:preview": "node scripts/render-logo-preview.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:rls": "node tests/rls/rls.test.mjs",
    "format": "prettier --write .",
    "gen:types": "supabase gen types typescript --linked > src/types/database.types.ts",
    "telegram:webhook": "node --env-file=.env.local scripts/telegram-webhook.mjs"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.8",
    "postcss": "^8.5.28",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
